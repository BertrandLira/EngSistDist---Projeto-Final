# Copie para .env na raiz e preencha. O docker compose lê variáveis ${VAR} deste arquivo.

# --- IA (perguntas / embeddings no worker FastAPI) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# --- Transcrição de vídeo (consumidor Redis: transcribe-worker) ---
# stub = texto + descrição de cena genéricos (POC)
# gemini = áudio via Gemini (exige GEMINI_API_KEY); se falhar → stub + log fallback_stub
# local = faster-whisper; api = OpenAI whisper-1 — qualquer falha → stub + log
TRANSCRIBE_MODE=stub
# Opcional: modelo multimodal (vazio = AI_MODEL ou gemini-2.5-flash)
TRANSCRIBE_GEMINI_MODEL=
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
